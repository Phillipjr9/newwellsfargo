# Install as /etc/workspace-app/workspace.env, mode 0600, owned by root.
# Replace the empty value on the host with a strong, unique secret (at least 32 characters).
# With no secret set, production admin sign-in is disabled.
DEMO_ADMIN_TOKEN=
# Leave disabled unless this single server should settle scheduled workspace actions.
WORKSPACE_SCHEDULER_INTERVAL_SECONDS=0
